# ─────────────────────────────────────────────────────────────
# Repo Health — Server environment variables
# Copy this file to `.env` and fill in the real values.
# ─────────────────────────────────────────────────────────────

# ── Required ──

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/repo-health

# Redis URL (Upstash, ElastiCache, or local).
# Required for BullMQ queues, socket.io fan-out, and rate limiting.
REDIS_URL=redis://localhost:6379

# JWT signing secrets — generate two long random strings.
# These also encrypt API keys at rest (JWT_SECRET seeds the cipher key).
JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string

# ── GitHub OAuth (for user sign-in) ──
# Create at https://github.com/settings/developers → OAuth Apps
# Callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub App (for repo access + webhook delivery) ──
# Create at https://github.com/settings/apps
# Permissions: Contents (Read), Metadata (Read), Pull requests (Read)
# Subscribe to events: Push, Pull request
# Webhook URL: <your public server URL>/webhooks/github
GITHUB_APP_ID=
GITHUB_APP_SLUG=repo-health
# Paste the contents of the downloaded .pem file. Newlines become \n.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Webhook secret you set in the GitHub App settings.
GITHUB_WEBHOOK_SECRET=

# ── Server config ──
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:3000

# ── Optional tuning ──
# CONTEXT_INCREMENTAL_FILE_CAP=300
# CONTEXT_BACKFILL_FILE_CAP=5000
# CONTEXT_INCREMENTAL_TIMEOUT_MS=300000
# CONTEXT_BACKFILL_TIMEOUT_MS=1800000
# CONTEXT_INCREMENTAL_CONCURRENCY=4
# CONTEXT_BACKFILL_CONCURRENCY=1

# ── Standalone worker process (optional) ──
# Run the API and worker in separate processes for scaling:
#   API:    WORKER_MODE=separate npm run dev
#   Worker: WORKER_TYPE=all      npm run dev:worker
# Allowed WORKER_TYPE: all | index | index-incremental | index-backfill | none
