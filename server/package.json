    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "graphology": "^0.26.0",
    "graphology-metrics": "^2.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "openai": "^4.85.4",
    "rate-limit-redis": "^5.0.0",
    "socket.io": "^4.8.1",
    "tree-sitter": "0.25.0",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-c-sharp": "0.23.1",
